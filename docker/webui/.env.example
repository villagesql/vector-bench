# cp .env.example .env, then fill these in.

# Absolute path of the vector-bench checkout on this host.
VB_ROOT=/home/you/vector-bench

# Own the files the UI writes. Run: id -u    and    id -g
VB_UID=1000
VB_GID=1000

# Group that owns the Docker socket. Run: stat -c '%g' /var/run/docker.sock
VB_DOCKER_GID=999

# Public hostname Caddy gets a certificate for. Must already resolve here.
VB_WEB_DOMAIN=bench.example.com

# Leave empty to have a password generated and printed once into the container
# log (docker compose logs webui). Set it to choose your own.
VB_WEB_PASSWORD=
