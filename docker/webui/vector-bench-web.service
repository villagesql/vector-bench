# vector-bench web interface, as a system service.
#
# The `web` command runs a container in the foreground so Ctrl-C stops it, which
# is right at a terminal and wrong on a machine you connect to: the interface
# dies with the SSH session that started it, and does not come back after a
# reboot. This unit is the same command with systemd holding it open.
#
# BEFORE YOU START IT
#   The image must exist, and the User= below must be able to reach Docker.
#   systemd grants that user the groups it has in /etc/group, so the check is:
#
#     sudo -u THAT-USER docker image inspect vector-bench/webui:latest >/dev/null \
#       && echo ok || echo 'no image, or no docker access for that user'
#
#   No docker access:  sudo usermod -aG docker THAT-USER
#   No image:          ./scripts/build-images.sh --engine webui
#
# INSTALL
#   sudo install -d -m 0750 /etc/vector-bench
#   sudo install -m 0600 docker/webui/web.env.example /etc/vector-bench/web.env
#   sudoedit /etc/vector-bench/web.env          # set the password
#   sudo cp docker/webui/vector-bench-web.service /etc/systemd/system/
#   sudoedit /etc/systemd/system/vector-bench-web.service   # set User and paths
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now vector-bench-web
#   systemctl status vector-bench-web
#   journalctl -u vector-bench-web -f
#
# The password lives in a root-only file rather than the unit, so it stays out
# of `systemctl cat`, shell history and the process list.

[Unit]
Description=vector-bench web interface
Documentation=file:///opt/vector-bench/docs/08-web-ui.md
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=exec

# The container runs as this user so that files it writes into the checkout are
# owned by whoever owns the checkout. Set both to match your install.
User=CHANGE-ME
WorkingDirectory=/home/CHANGE-ME/vector-bench

EnvironmentFile=/etc/vector-bench/web.env
ExecStart=/bin/sh -c 'exec ./run-benchmark.sh web $VB_WEB_ARGS'

Restart=on-failure
RestartSec=5s

# KillMode=process was here, on the theory that it spared a benchmark launched
# from the interface. It did not: that run is a process inside the web
# container, so it dies when the container does whatever systemd signals. What
# it actually did was leave the `docker run` client alive after a stop, holding
# the published port, so the next start failed with "port is in use".
KillMode=mixed
TimeoutStopSec=30s

# Belt and braces around the same thing: the container is named for its port,
# so a leftover from an unclean stop can be cleared deterministically. The
# leading `-` means a missing container is not an error.
# Remove any of ours still holding the port, whatever it is called. An exact
# name misses containers started by an older build, which used the pid rather
# than the port, and one of those pins the port through every restart.
ExecStartPre=-/bin/sh -c 'docker ps -q --filter name=^/vb-webui- | xargs -r docker rm -f'
ExecStopPost=-/bin/sh -c 'docker ps -q --filter name=^/vb-webui- | xargs -r docker rm -f' 

# It needs the Docker socket and the checkout, and nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=/home/CHANGE-ME/vector-bench

[Install]
WantedBy=multi-user.target
