# Settings for the vector-bench web service. Install to /etc/vector-bench/web.env
# with mode 0600: it holds the password.
#
#   sudo install -d -m 0750 /etc/vector-bench
#   sudo install -m 0600 docker/webui/web.env.example /etc/vector-bench/web.env

# The password for the interface. Leave it empty and one is generated on first
# start and printed once to the journal:
#   journalctl -u vector-bench-web | grep -A2 'generated a password'
VB_WEB_PASSWORD=

# Arguments to `./run-benchmark.sh web`.
#
# Reached over an SSH tunnel (recommended). Loopback only, so --auth is needed
# explicitly; without it a tunnel is the only thing standing in the way.
VB_WEB_ARGS=--allow-control --auth

# Reachable on the network, with TLS terminated by something in front. A
# non-loopback address turns auth on by itself, and --behind-proxy marks the
# session cookie Secure.
# VB_WEB_ARGS=--allow-control --host 0.0.0.0 --behind-proxy

# Reachable on a private network you already trust (WireGuard, Tailscale),
# where the transport is encrypted but a password is still wanted.
# VB_WEB_ARGS=--allow-control --host 100.x.y.z --auth
