# Working directories — all regenerable, never committed
/sources/
/work/
/datasets/
/results/
/state/
/.cache/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store

# Blog drafts and their figures live outside the repo, next to the .docx.
# This is here so a stray `git add -A` cannot pull them back in.
/docs/blog/

# Local overrides
config/local.yml
.env

# Agent worktrees. Not source; an outer clone cannot resolve them, and a
# `git add -A` here commits them as gitlinks.
.claude/
